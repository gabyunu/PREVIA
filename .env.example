# Valores ficticios para desarrollo local exclusivamente.
MYSQL_DATABASE=previa_dev
MYSQL_USER=previa
MYSQL_PASSWORD=demo_previa_local
MYSQL_ROOT_PASSWORD=demo_root_local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Exclusivamente Mailpit y dominios ficticios; nunca SMTP institucional.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
AUTH_ALLOWED_DOMAINS=estudiantes.example.test
AUTH_FRONTEND_ORIGIN=http://127.0.0.1:4200
AUTH_COOKIE_SECURE=false
# Generar localmente con: python3 -c 'import secrets; print(secrets.token_hex(32))'
AUTH_HMAC_KEY=
AUTH_OTP_SECONDS=600
AUTH_OTP_ATTEMPTS=5
AUTH_RESEND_SECONDS=60
AUTH_EMAIL_HOURLY=5
AUTH_IP_HOURLY=30
AUTH_SESSION_SECONDS=28800
AUTH_IDLE_SECONDS=1800
