      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "http://127.0.0.1:4200"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
