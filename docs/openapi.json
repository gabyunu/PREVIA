{
  "openapi": "3.0.3",
  "info": {
    "title": "PREVIA - Flask / MySQL API",
    "version": "1.0.0",
    "description": "Provisional academic planning prototype; no enrollment or seat reservation."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "components": {
    "securitySchemes": {
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "previa_session"
      }
    },
    "schemas": {
      "Email": {
        "type": "object",
        "required": [
          "correo"
        ],
        "additionalProperties": false,
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "example": "demo@estudiantes.example.test"
          }
        }
      },
      "Verify": {
        "type": "object",
        "required": [
          "desafio_id",
          "codigo"
        ],
        "additionalProperties": false,
        "properties": {
          "desafio_id": {
            "type": "string"
          },
          "codigo": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "revision_esperada",
          "malla_id",
          "semestre_declarado",
          "estados"
        ],
        "additionalProperties": false,
        "properties": {
          "revision_esperada": {
            "type": "integer",
            "minimum": 0
          },
          "malla_id": {
            "type": "integer",
            "minimum": 1
          },
          "semestre_declarado": {
            "type": "integer",
            "minimum": 1
          },
          "estados": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/State"
            }
          }
        }
      },
      "State": {
        "type": "object",
        "required": [
          "malla_asignatura_id",
          "estado"
        ],
        "properties": {
          "malla_asignatura_id": {
            "type": "integer",
            "minimum": 1
          },
          "estado": {
            "type": "string",
            "enum": [
              "aprobada",
              "reprobada",
              "no_cursada"
            ]
          }
        }
      },
      "Draft": {
        "type": "object",
        "required": [
          "revision_esperada",
          "revision_perfil",
          "selecciones"
        ],
        "properties": {
          "revision_esperada": {
            "type": "integer",
            "minimum": 0
          },
          "revision_perfil": {
            "type": "integer",
            "minimum": 1
          },
          "selecciones": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "$ref": "#/components/schemas/Selection"
            }
          }
        }
      },
      "Selection": {
        "type": "object",
        "required": [
          "malla_asignatura_id",
          "prioridad"
        ],
        "properties": {
          "malla_asignatura_id": {
            "type": "integer"
          },
          "prioridad": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          }
        }
      },
      "Submit": {
        "type": "object",
        "required": [
          "revision_esperada",
          "revision_perfil",
          "version_trabajo_id"
        ],
        "properties": {
          "revision_esperada": {
            "type": "integer",
            "minimum": 0
          },
          "revision_perfil": {
            "type": "integer",
            "minimum": 1
          },
          "version_trabajo_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PlannedCapacityNew": {
        "type": "object",
        "required": [
          "periodo_id",
          "malla_asignatura_id",
          "cupos_planificados"
        ],
        "additionalProperties": false,
        "properties": {
          "periodo_id": {
            "type": "integer",
            "minimum": 1
          },
          "malla_asignatura_id": {
            "type": "integer",
            "minimum": 1
          },
          "cupos_planificados": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "nullable": true
          }
        }
      },
      "PlannedCapacityUpdate": {
        "type": "object",
        "required": [
          "cupos_planificados"
        ],
        "additionalProperties": false,
        "properties": {
          "cupos_planificados": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000,
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Forbidden / invalid CSRF or origin"
